# Backend app settings
APP_HOST=0.0.0.0
APP_PORT=8000

# MongoDB connection settings
# MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD / MONGO_INITDB_DATABASE are used
# by compose.yaml to initialize the local MongoDB container; MONGODB_URL is what the app uses.
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=backend
MONGODB_URL=mongodb://mongo:changeme@localhost:27017/backend?authSource=admin

# Logging (shipped to Loki; view in Grafana at http://localhost:3000)
LOG_LEVEL=INFO
LOKI_URL=http://localhost:3100/loki/api/v1/push

# Grafana login (used to create the admin account on first container start)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
